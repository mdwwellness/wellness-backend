# Copy this file to ".env" and fill in real values. Never commit the real .env.

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Connection string for your MongoDB Atlas cluster (or local instance).
# Atlas: Database → Connect → Drivers. Remember to allow Render's IP
# (Network Access → 0.0.0.0/0) since Render free tier has no fixed IP.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Long, random, and DIFFERENT from each other. Used to sign/verify login tokens.
# Generate e.g. with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# The frontend origin allowed to call this API (no trailing slash).
# e.g. https://wellness.mydawaiwala.com  (use http://localhost:3000 for local dev)
FRONT_END_URL=http://localhost:3000

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set to "production" on Render so auth cookies are marked Secure (HTTPS-only).
NODE_ENV=development

# Render injects PORT automatically — only set this for local runs if you want
# a fixed port. The server falls back to 10000.
PORT=10000

# ── UploadThing (invoice PDFs + optional server uploads) ─────────────────────
# Same token as the Next.js dashboard (UPLOADTHING_TOKEN in WellnessFrontend).
# Required for `POST /api/invoices/:invoiceId/pdf`.
UPLOADTHING_TOKEN=

# ── Customers' App (/api/customer-app) ───────────────────────────────────────
# Signs customer login tokens. At least 32 characters and DIFFERENT from
# JWT_SECRET, otherwise every /api/customer-app route answers 503 (the staff
# dashboard keeps working). Generate e.g. with: openssl rand -hex 32
CUSTOMER_JWT_SECRET=

# MSG91 phone OTP (same MSG91 account as the patient site). The template id is
# the DLT-approved OTP template; without both, phone sign-in answers 503.
MSG91_AUTH_TOKEN=
MSG91_TEMPLATE_ID=

# Local testing only, never on Render: a fixed OTP (6+ digits) for this one
# 10-digit phone, so tests can sign in without sending an SMS.
MSG91_DEMO_PHONE=
MSG91_DEMO_OTP=

# Database holding the shared customer accounts (`users`). Must match the
# patient site's MONGODB_DB. Defaults to mdw.
IDENTITY_DB=mdw

# Browser origins of the Customers' App allowed by CORS, comma-separated.
# Exact scheme + host + port, no trailing slash, e.g. https://app.example.com
CUSTOMER_APP_URL=

# Number of reverse proxies in front of the API (a whole number, e.g. 1).
# When set, per-IP rate limits use the client address Express derives from the
# trusted hops instead of the spoofable first X-Forwarded-For entry. On Render,
# confirm the hop count from a real request's X-Forwarded-For before setting it.
# Leave empty to keep Express's default (no proxy trusted).
TRUST_PROXY=
